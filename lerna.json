{
  "version": "independent",
  "packages": [
    "packages/**/*"
  ],
  "npmClient": "npm",
  "command": {
    "version": {
      "allowBranch": [
        "main",
        "master"
      ],
      "conventionalCommits": true,
      "conventionalGraduate": true,
      "message": "chore(release): publish [skip lerna]"
    }
  },
  "ignoreChanges": [
    "**/demo/**",
    "**/test/**",
    "**/*.md",
    "**/*.config.js",
    "**/.*"
  ],
  "$schema": "node_modules/lerna/schemas/lerna-schema.json"
}
